        "import os\n",
        "import csv\n",
        "from datetime import datetime\n",
        "\n",
        "os.makedirs(\"data\", exist_ok=True)\n",
        "\n",
        "total_records = 0\n",
        "total_rejects = 0\n",
        "\n",
        "with open(\"data/run_history.csv\", \"a\", newline=\"\") as h:\n",
        "    writer = csv.writer(h)\n",
        "\n",
        "    for filename in os.listdir(\"data\"):\n",
        "        if filename.endswith(\".txt\") and not filename.startswith(\"report\"):\n",
        "            path = \"data/\" + filename\n",
        "\n",
        "            with open(path, \"r\") as f:\n",
        "                lines = f.readlines()\n",
        "\n",
        "            valid = []\n",
        "            rejected = []\n",
        "\n",
        "            for line in lines:\n",
        "                parts = line.strip().split(\",\")\n",
        "                if (len(parts) == 3\n",
        "                        and parts[0].startswith(\"PE-\")\n",
        "                        and parts[1].replace(\".\", \"\", 1).isdigit()\n",
        "                        and parts[2] in [\"DAY\", \"NIGHT\", \"SWING\"]):\n",
        "                    valid.append(parts)\n",
        "                else:\n",
        "                    rejected.append(line.strip())\n",
        "\n",
        "            total = sum(float(r[1]) for r in valid)\n",
        "            report = \"data/report_\" + filename\n",
        "\n",
        "            with open(report, \"w\") as f:\n",
        "                f.write(\"File: \" + filename + \"\\n\")\n",
        "                f.write(\"Valid: \" + str(len(valid)) + \"\\n\")\n",
        "                f.write(\"Rejected: \" + str(len(rejected)) + \"\\n\")\n",
        "                f.write(\"Total: \" + str(round(total, 2)))\n",
        "\n",
        "            total_records += len(valid)\n",
        "            total_rejects += len(rejected)\n",
        "\n",
        "            writer.writerow([\n",
        "                datetime.now(),\n",
        "                filename,\n",
        "                len(valid),\n",
        "                len(rejected)\n",
        "            ])\n",
        "\n",
        "# Combined report\n",
        "with open(\"data/plant_summary.txt\", \"w\") as f:\n",
        "    f.write(\"PLANT SUMMARY\\n\")\n",
        "    f.write(\"Total Valid: \" + str(total_records) + \"\\n\")\n",
        "    f.write(\"Total Rejected: \" + str(total_rejects))\n",
        "\n",
        "print(\"Batch processing completed!\")\n",
        "print(\"Total Valid:\", total_records)\n",
        "print(\"Total Rejected:\", total_rejects)"
      ],
