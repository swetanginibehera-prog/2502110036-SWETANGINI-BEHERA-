        "import csv\n",
        "import re\n",
        "\n",
        "valid = []\n",
        "rejected = []\n",
        "\n",
        "pattern = r\"^(PE-\\d{4}),(\\d+\\.\\d{2}),(DAY|NIGHT|SWING)$\"\n",
        "\n",
        "# Read input file\n",
        "with open(\"data/shift_log.txt\", \"r\") as f:\n",
        "    for line in f:\n",
        "        line = line.strip()\n",
        "        if not line:\n",
        "            continue\n",
        "        if re.fullmatch(pattern, line):\n",
        "            valid.append(line.split(\",\"))\n",
        "        else:\n",
        "            rejected.append([line, \"Invalid data\"])\n",
        "\n",
        "# Calculate total\n",
        "total = sum(float(r[1]) for r in valid)\n",
        "\n",
        "# Write report\n",
        "with open(\"data/report.txt\", \"w\") as f:\n",
        "    f.write(\"FACTORY REPORT\\n\")\n",
        "    f.write(\"Valid Records: \" + str(len(valid)) + \"\\n\")\n",
        "    f.write(\"Rejected Records: \" + str(len(rejected)) + \"\\n\")\n",
        "    f.write(\"Total Measurement: \" + str(round(total, 2)))\n",
        "\n",
        "# Write rejected records\n",
        "with open(\"data/rejects.csv\", \"w\", newline=\"\") as f:\n",
        "    writer = csv.writer(f)\n",
        "    writer.writerow([\"Data\", \"Reason\"])\n",
        "    writer.writerows(rejected)\n",
        "\n",
