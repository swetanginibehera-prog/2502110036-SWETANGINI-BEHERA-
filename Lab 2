IT8: Fine — The Inspector, Typed
def typed_inspector():
    print("[IT8] Typed Go/No-Go Inspector")
    target = 25.00
    tolerance = 0.05
    lower_limit = target - tolerance
    upper_limit = target + tolerance
    
    diameter = float(input("Enter part diameter: "))
    if lower_limit <= diameter <= upper_limit:
        print("Result: ACCEPT")
    else:
        print("Result: REJECT")
        if diameter > upper_limit:
            print("Violation: Too big!")
        else:
            print("Violation: Too small!")

IT6: Precision — The Shift Report
def shift_report():
    print("[IT6] Precision Shift Report")
    inspected_count = 10
    accepted_count = 0
    rejected_count = 0
    
    lower_limit = 24.95
    upper_limit = 25.05
    
    for i in range(1, inspected_count + 1):
        val = float(input(f"Enter diameter for part {i}: "))
        if lower_limit <= val <= upper_limit:
            print("-> ACCEPT")
            accepted_count = accepted_count + 1
        else:
            print("-> REJECT")
            rejected_count = rejected_count + 1
            
    print("==============================")
    print("Shift Report: 10 Inspected,", accepted_count, "accepted,", rejected_count, "rejected.")
    print("==============================")

